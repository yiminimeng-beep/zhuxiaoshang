# 助小商 · 本地开发环境变量模板（复制为 `.env` 后填写，勿提交真 Key）
# cp .env.example .env

# DeepSeek（文案对话 / 复写 / 生成 / 质检 + 视觉预检 / OCR）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-v4-flash
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp

# 视频厂商（空 = 生成阶段报「视频模型尚未接入」；客户也可在站内 BYOK）
JIMENG_API_KEY=
JIMENG_BASE_URL=https://api.jimeng.example
KLING_API_KEY=
KLING_BASE_URL=https://api.kling.example
